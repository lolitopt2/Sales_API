{
  "info": {
    "name": "Sales Management API - Clean Architecture & CQRS",
    "_postman_id": "a987d6e5-4321-4f12-89ab-123456789abc",
    "description": "Complete Postman collection for Sales Management REST API with Clean Architecture, CQRS (MediatR), FluentValidation, and JWT Bearer Tokens with Admin and User roles.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01. Authentication",
      "item": [
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    pm.environment.set(\"jwt_token\", data.token);",
                  "    pm.test(\"Login Successful & Token Saved\", function () {",
                  "        pm.expect(data.token).to.be.a('string');",
                  "        pm.expect(data.user.role).to.eql('Admin');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@salesmanagement.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login as User",
          "event": [
            {
